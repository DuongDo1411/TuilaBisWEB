# Tạo bằng: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Đặt cùng giá trị này trong cấu hình môi trường của hosting để cookie tiếp tục hợp lệ.
GACHA_COOKIE_SECRET=replace-with-a-random-64-character-hex-string
# Bật true tại local hoặc Vercel để thử quay vô hạn; false = giới hạn mỗi ngày.
GACHA_UNLIMITED_SPINS=false
